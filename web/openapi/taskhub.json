{
  "openapi": "3.1.1",
  "info": {
    "title": "TaskHub.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "TaskHub.Api"
        ],
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/items": {
      "get": {
        "tags": [
          "ItemsEndpoints"
        ],
        "summary": "Liste les éléments actifs, filtrés, triés et paginés.",
        "description": "Filtres multi-valués (répéter le paramètre) : source, project, status. dueBefore est inclusif. q cherche dans le titre, l'identifiant externe et le projet. sort : updatedAt (défaut), dueDate, priority, status, title, project, source ; préfixer par '-' pour l'ordre décroissant (défaut : -updatedAt).",
        "operationId": "GetItems",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "project",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "dueBefore",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/sources": {
      "get": {
        "tags": [
          "SourcesEndpoints"
        ],
        "summary": "État de chaque source : dernière synchro, succès ou erreur, nombre d'éléments actifs.",
        "operationId": "GetSources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourcesStatusDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync": {
      "post": {
        "tags": [
          "SourcesEndpoints"
        ],
        "summary": "Lance immédiatement une synchronisation de toutes les sources et attend sa fin.",
        "description": "Répond 409 si une synchronisation est déjà en cours.",
        "operationId": "Sync",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SourcesStatusDto": {
        "required": [
          "isSyncing",
          "sources"
        ],
        "type": "object",
        "properties": {
          "isSyncing": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceStatusDto"
            }
          }
        }
      },
      "SourceStatusDto": {
        "required": [
          "name",
          "activeItemCount",
          "lastSuccessAt",
          "lastRun"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "activeItemCount": {
            "type": "integer",
            "format": "int32"
          },
          "lastSuccessAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastRun": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncRunDto"
              }
            ]
          }
        }
      },
      "SyncResponseDto": {
        "required": [
          "results"
        ],
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncSourceResultDto"
            }
          }
        }
      },
      "SyncRunDto": {
        "required": [
          "startedAt",
          "finishedAt",
          "succeeded",
          "itemCount",
          "error"
        ],
        "type": "object",
        "properties": {
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "succeeded": {
            "type": "boolean"
          },
          "itemCount": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SyncSourceResultDto": {
        "required": [
          "source",
          "succeeded",
          "itemCount",
          "error"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "succeeded": {
            "type": "boolean"
          },
          "itemCount": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "WorkItemDto": {
        "required": [
          "id",
          "source",
          "externalId",
          "title",
          "url",
          "project",
          "status",
          "rawStatus",
          "nativePriority",
          "dueDate",
          "updatedAt",
          "lastSyncedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "externalId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/WorkItemStatus"
          },
          "rawStatus": {
            "type": "string"
          },
          "nativePriority": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSyncedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WorkItemPageDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkItemDto"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "WorkItemStatus": {
        "enum": [
          "Todo",
          "InProgress",
          "Blocked",
          "Done"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "TaskHub.Api"
    },
    {
      "name": "ItemsEndpoints"
    },
    {
      "name": "SourcesEndpoints"
    }
  ]
}