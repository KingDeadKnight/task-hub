{
  "name": "taskhub-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript openapi/taskhub.json -o src/api/schema.d.ts",
    "e2e": "playwright test",
    "e2e:image": "docker build -t taskhub:e2e ..",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.93.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
