        "To Review": "InProgress",
        "Ready to be tested": "InProgress"
      }
    },
    "Jira": {
      "BaseUrl": "",
      "Email": "",
      "Projects": [],
      "MaxItems": 1000,
      "StatusMappings": {},
      "PriorityMappings": {}
    }
  }
}
