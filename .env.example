# Copy to .env (ignored by git) and fill in; docker compose reads it automatically.
# Nested settings use a double underscore: Sources:AzureDevOps:Pat -> Sources__AzureDevOps__Pat.
# Only the variables listed in docker-compose.yml are passed to the container.

TZ=Europe/Brussels

# Azure DevOps (PAT scope: Work Items > Read)
Sources__AzureDevOps__Organization=
Sources__AzureDevOps__Pat=

# Jira Cloud (API token: id.atlassian.com > Security > API tokens)
Sources__Jira__BaseUrl=
Sources__Jira__Email=
Sources__Jira__ApiToken=

# Optional tuning
Sync__IntervalMinutes=5
Scoring__TodayCount=5
